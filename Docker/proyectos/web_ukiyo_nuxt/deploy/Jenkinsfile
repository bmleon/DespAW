pipeline {
    agent {
        kubernetes {
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              containers:
              - name: docker-client
                image: docker:24-cli
                command: ['cat']
                tty: true
              - name: docker-daemon
                image: docker:24-dind
                securityContext:
                  privileged: true
                env:
                - name: DOCKER_TLS_CERTDIR
                  value: ""
              - name: kubectl
                image: bitnami/kubectl:latest
                command: ['cat']
                tty: true
                securityContext:
                  runAsUser: 0
            '''
        }
    }

    environment {
        DOCKER_BASE_IMAGE = "bmleon/webcliente"
        DOCKER_TAG        = "${BUILD_NUMBER}"
        PROJECT_DIR       = "Docker/proyectos/web_ukiyo_nuxt"
        K8S_DIR           = "Docker/proyectos/web_ukiyo_nuxt/deploy/kubernetes"
        DOCKER_HOST       = "tcp://localhost:2375"
    }

    stages {
        stage('Validar Entorno y Motor') {
            steps {
                container('docker-client') {
                    echo "🛡️ Verificando estado del servicio interno de Docker..."
                    sh 'while ! docker info >/dev/null 2>&1; do sleep 2; done'
                    echo "✅ Motor listo para la compilación."
                }
            }
        }

        stage('Construir Imagen de Producción (Nuxt)') {
            steps {
                container('docker-client') {
                    dir("${PROJECT_DIR}") {
                        echo "🏗️ Iniciando Multi-Stage Build desde la carpeta deploy..."
                        
                        // CORREGIDO: Le indicamos explícitamente que busque el Dockerfile dentro de deploy/
                        sh "docker build -t ${DOCKER_BASE_IMAGE}:${DOCKER_TAG} -t ${DOCKER_BASE_IMAGE}:latest -f deploy/Dockerfile ."
                    }
                }
            }
        }

        stage('Publicar en Docker Hub') {
            steps {
                container('docker-client') {
                    echo "🔐 Autenticando en Docker Hub de manera segura..."
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', 
                                                     passwordVariable: 'DOCKER_HUB_PASSWORD', 
                                                     usernameVariable: 'DOCKER_HUB_USER')]) {
                        
                        sh "echo \$DOCKER_HUB_PASSWORD | docker login -u \$DOCKER_HUB_USER --password-stdin"
                        
                        echo "🚀 Subiendo tags a la nube..."
                        sh "docker push ${DOCKER_BASE_IMAGE}:${DOCKER_TAG}"
                        sh "docker push ${DOCKER_BASE_IMAGE}:latest"
                    }
                }
            }
        }

        stage('Desplegar en Cluster Kubernetes') {
            steps {
                container('kubectl') {
                    dir("${K8S_DIR}") {
                        echo "⚙️ Sincronizando manifiestos con el Orquestador..."
                        sh "kubectl apply -f namespace-webcliente.yml"
                        sh "kubectl apply -f deploy-webcliente.yml"
                        sh "kubectl apply -f service-webcliente.yml"
                        sh "kubectl apply -f ingress-webcliente.yml"
                        
                        echo "🔄 Ejecutando Rollout seguro para limpiar caché y actualizar la web..."
                        sh "kubectl rollout restart deployment nuxt-web-cliente -n web-cliente"
                        
                        echo "⏳ Verificando que el nuevo pod levante correctamente..."
                        sh "kubectl rollout status deployment nuxt-web-cliente -n web-cliente --timeout=90s"
                    }
                }
            }
        }
    }

    post {
        success { 
            echo "✅ ¡Despliegue Exitoso! Versión v${DOCKER_TAG} de Ukiyo en marcha."
        }
        failure { 
            echo "❌ CRÍTICO: Error detectado en el pipeline. Despliegue abortado de forma segura." 
        }
    }
}